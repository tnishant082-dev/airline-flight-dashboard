table DimRoute
	lineageTag: 041fa069-e3a9-4b40-86e8-35087413e090

	column RouteKey
		dataType: int64
		isHidden
		lineageTag: 0d5a3db5-6c03-4959-b730-dd6ffe36606c
		summarizeBy: none
		sourceColumn: RouteKey

	column Route
		dataType: string
		lineageTag: f773b765-c2bc-4e4d-9807-dd23ad70fcf5
		summarizeBy: none
		sourceColumn: Route

	column Origin
		dataType: string
		lineageTag: 50c950c2-4862-4841-9e50-b15538732f82
		summarizeBy: none
