	column FlightCountSample
		dataType: int64
		lineageTag: 53ae06e5-dff7-4d71-9417-e499ce7336ed
		summarizeBy: sum
		sourceColumn: FlightCountSample

	partition DimRoute = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "\\dim_route.csv"), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(#"Promoted Headers", {{"RouteKey", Int64.Type}, {"Route", type text}, {"Origin", type text}, {"Dest", type text}, {"FlightCountSample", Int64.Type}})
				in
				    Typed

